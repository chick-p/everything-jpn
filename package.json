{
  "name": "everything-jpn",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "lint": "run-p lint:*",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint \"./src/**/*.ts\" \"./public/static/js/**/*.js\"",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier -w .",
    "fix:eslint": "pnpm run lint:eslint --fix"
  },
  "dependencies": {
    "@hono/cloudflare-workers": "^1.0.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.151.2"
  }
}
